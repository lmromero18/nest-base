{
  "info": {
    "_postman_id": "5c2962f0-eef5-48c2-bbc9-c296724bb73b",
    "name": "CENSO API PUBLICO",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "26766333"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST - Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    const token = json?.access_token || json?.token || json?.data?.access_token || json?.data?.token;",
                  "    if (token) {",
                  "        pm.collectionVariables.set('authToken', token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/seguridad/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "seguridad",
                "login"
              ]
            },
            "description": "Autentica contra el proveedor externo y devuelve un token JWT. El token se guarda automáticamente en la variable authToken."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Campamentos",
      "item": [
        {
          "name": "GET - Resumen",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/campamentos/resumen",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "campamentos",
                "resumen"
              ]
            },
            "description": "Devuelve el resumen de niños registrados por campamento, género y rango de edad. Requiere token Bearer."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "GET - Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": "Verifica que la API esté funcionando correctamente."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3002"
    },
    {
      "key": "username",
      "value": "V12345678"
    },
    {
      "key": "password",
      "value": "MTIzNDU2Nzg="
    },
    {
      "key": "authToken",
      "value": ""
    }
  ]
}
