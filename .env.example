# Environment variables for the application
APP_NAME=NEST-BASE
PORT=3000
NODE_ENV=development

# Logging Configuration
LOG_LEVEL=debug
APP_LOG_DIR=logs
APP_LOG_MAX_SIZE=20m
APP_LOG_MAX_FILES=14d
APP_ERROR_LOG_MAX_FILES=30d

# Database Configuration
DB_BASE_HOST=localhost
DB_BASE_PORT=5432
DB_BASE_USERNAME=postgres
DB_BASE_PASSWORD=postgres
DB_BASE_DATABASE=postgres
DB_BASE_SCHEMA=public
DB_BASE_SYNCHRONIZE=false
DB_BASE_LOGGING=false
DB_BASE_SSL=false
DB_BASE_POOL_MAX=10

# JWT verification (obligatorio para rutas protegidas)
# Clave pública PEM del emisor de tokens (RS256/ES256). Admite \n escapados.
JWT_PUBLIC_KEY=
# Alternativa simétrica (HS256) si no hay clave pública
JWT_SECRET=

# Auth API Configuration (login proxy)
AUTH_API_URL=https://auth.example.com/
AUTH_CLIENT_ID=your-client-id
AUTH_CLIENT_SECRET=your-client-secret

# CORS: orígenes permitidos separados por coma (vacío = abierto en dev, cerrado en prod)
CORS_ORIGINS=

# Swagger UI en /docs (por defecto: activo salvo en producción)
SWAGGER_ENABLED=

# Rate limiting global
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Cliente HTTP saliente
HTTP_CLIENT_TIMEOUT_MS=10000
HTTP_CLIENT_REJECT_UNAUTHORIZED=true

# SMTP para el módulo de notificaciones
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASS=
NOTIFICATION_SMTP_FROM=
