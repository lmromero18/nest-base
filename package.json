{
  "name": "nest-base",
  "version": "0.0.1",
  "description": "Plantilla base para construir APIs REST con NestJS. Su eje es una **librería CRUD genérica** (`BaseService` + `CrudControllerFactory`) que da a cada módulo listados con filtros dinámicos, paginación, validación real y auditoría sin repetir código.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "nest build",
    "build:core": "bun packages/core/build.ts",
    "build:http-core": "bun packages/http-core/build.ts",
    "audit:core": "bun packages/core/audit.ts",
    "audit:http-core": "bun packages/http-core/audit.ts",
    "audit:tarball": "bun packages/core/audit-tarball.ts",
    "audit:http-core:tarball": "bun packages/http-core/audit-tarball.ts",
    "verify:consumer": "bun tools/verify-consumer.ts",
    "verify:http-core:consumer": "bun packages/http-core/verify-consumer.ts",
    "audit:promotion": "bun tools/promotion-gates.ts",
    "install:frozen": "bun install --frozen-lockfile",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"tools/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"*.{js,mjs,json}\" \"docs/**/*.md\"",
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "start:prod": "NODE_ENV=production bun src/main.ts",
    "lint": "eslint \"{src,apps,libs,test,tools,packages}/**/*.{ts,tsx}\"",
    "lint:check": "eslint \"{src,apps,libs,test,tools,packages}/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"{src,apps,libs,test,tools,packages}/**/*.{ts,tsx}\" --fix",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"tools/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"*.{js,mjs,json}\" \"docs/**/*.md\"",
    "diff:check": "git diff --check",
    "quality:check": "bun run test:focused:check && bun run lint:check && bun run format:check && bun run typecheck && bun run diff:check",
    "test:focused:check": "bun tools/verify-no-focused-tests.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "test:debug": "bun test --inspect-brk",
    "test:e2e": "bun test e2e",
    "migration:run": "bun node_modules/typeorm/cli.js -d src/config/database/data-source.ts migration:run",
    "migration:revert": "bun node_modules/typeorm/cli.js -d src/config/database/data-source.ts migration:revert",
    "migration:show": "bun node_modules/typeorm/cli.js -d src/config/database/data-source.ts migration:show",
    "migration:generate": "bun node_modules/typeorm/cli.js -d src/config/database/data-source.ts migration:generate",
    "module:generate": "bun tools/module-generator/cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "nest-winston": "^1.10.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "@nest-base/core": "0.1.0"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmromero18/nest-base.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/lmromero18/nest-base/issues"
  },
  "homepage": "https://github.com/lmromero18/nest-base#readme"
}
